{
  "name": "@asterism-dev/lumen",
  "version": "0.3.0",
  "description": "Vue 3 component library",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./table": {
      "types": "./dist/types/table/index.d.ts",
      "import": "./dist/table.js"
    },
    "./editor": {
      "types": "./dist/types/editor/index.d.ts",
      "import": "./dist/editor.js"
    },
    "./markdown": {
      "types": "./dist/types/markdown/index.d.ts",
      "import": "./dist/markdown.js"
    },
    "./dock": {
      "types": "./dist/types/dock/index.d.ts",
      "import": "./dist/dock.js"
    },
    "./style.css": "./dist/index.css",
    "./table.css": "./dist/table.css",
    "./editor.css": "./dist/editor.css",
    "./markdown.css": "./dist/markdown.css",
    "./dock.css": "./dist/dock.css"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.json --declaration --emitDeclarationOnly --outDir dist/types",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:examples": "vite build --config docs/vite.config.ts",
    "docs:build": "npm run docs:examples && uvx zensical build --clean",
    "docs:serve": "npm run docs:examples && uvx zensical serve",
    "check:isolation": "node scripts/check-isolation.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.0.0",
    "reka-ui": "^2.11.0"
  },
  "peerDependencies": {
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/highlight": "^1.0.0",
    "@tanstack/vue-table": "^9.0.0",
    "codemirror": "^6.0.0",
    "dockview-vue": "^8.0.0",
    "dompurify": "^3.0.0",
    "highlight.js": "^11.0.0",
    "markdown-it": "^15.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/lang-markdown": {
      "optional": true
    },
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    },
    "@tanstack/vue-table": {
      "optional": true
    },
    "codemirror": {
      "optional": true
    },
    "dockview-vue": {
      "optional": true
    },
    "dompurify": {
      "optional": true
    },
    "highlight.js": {
      "optional": true
    },
    "markdown-it": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.0.0",
    "@tanstack/vue-table": "^9.0.0",
    "@types/markdown-it": "^14.0.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.6.0",
    "codemirror": "^6.0.0",
    "dockview-vue": "^8.4.0",
    "dompurify": "^3.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "highlight.js": "^11.11.1",
    "jsdom": "^27.0.0",
    "markdown-it": "^15.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12"
  }
}
